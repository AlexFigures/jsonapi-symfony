{
  "name": "alexfigures/symfony-jsonapi-bundle",
  "description": "JSON:API 1.1 bundle for Symfony with Doctrine and custom persistence",
  "type": "symfony-bundle",
  "license": "MIT",
  "homepage": "https://github.com/AlexFigures/jsonapi-symfony",
  "keywords": [
    "jsonapi",
    "symfony",
    "symfony-bundle",
    "api",
    "rest",
    "specification"
  ],
  "require": {
    "php": "^8.2",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/property-access": "^7.4 || ^8.0",
    "symfony/property-info": "^7.4 || ^8.0",
    "symfony/serializer": "^7.4 || ^8.0",
    "symfony/uid": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.2",
    "doctrine/dbal": "^3.8 || ^4.3",
    "doctrine/orm": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "jbelien/phpstan-sarif-formatter": "^1.2",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5.50",
    "rector/rector": "^2.0",
    "spatie/phpunit-snapshot-assertions": "^5.2",
    "symfony/cache": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/phpunit-bridge": "^7.4 || ^8.0",
    "symfony/var-exporter": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "AlexFigures\\JsonApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlexFigures\\JsonApi\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "support": {
    "issues": "https://github.com/AlexFigures/jsonapi-symfony/issues",
    "discussions": "https://github.com/AlexFigures/jsonapi-symfony/discussions",
    "docs": "https://github.com/AlexFigures/jsonapi-symfony/tree/main/docs",
    "source": "https://github.com/AlexFigures/jsonapi-symfony"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/AlexFigures"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "doctrine/orm": "Built-in Doctrine provider: ORM 3.x (see tested compatibility matrix).",
    "doctrine/dbal": "Built-in Doctrine provider: DBAL 3.8+ / 4.3+; see tested compatibility matrix."
  }
}
